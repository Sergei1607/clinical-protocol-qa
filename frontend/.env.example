# Copy to  frontend/.env  and adjust.  .env is gitignored.
#
# Base URL of the FastAPI backend, no trailing slash. Vite inlines this at BUILD
# time, so it must be set before `npm run build` / before the Vercel build runs.
#   local dev : http://localhost:8000
#   production: set in the Vercel dashboard (Settings -> Environment Variables)
#               to the Render backend URL, e.g. https://clinical-protocol-qa.onrender.com
VITE_API_URL=http://localhost:8000
