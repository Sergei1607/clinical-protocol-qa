# Supabase Postgres connection strings (same free project as portfolio Project 2).
# Copy to  backend/.env  and fill in real values.  .env is gitignored.
#
# Two roles, same as Project 2:
#   - OWNER: full DDL + write. Used ONLY locally (setup_supabase.py, load_embeddings.py).
#            Never set on Render.
#   - READONLY (app_readonly): SELECT only. This is what the deployed API uses,
#            and what test_retrieval.py uses.
#
# Free-tier note: Supabase's direct connection (port 5432) is IPv6-only; use the
# Session-mode pooler host (…pooler.supabase.com:5432) if your network is IPv4.
# Either works here. Keep sslmode=require.

SUPABASE_OWNER_URL=postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres?sslmode=require
SUPABASE_READONLY_URL=postgresql://app_readonly:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres?sslmode=require

# Anthropic API key for answer generation (the /ask endpoint). Same key as
# Projects 1 & 2. On Render this is set in the dashboard, not from a file.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the answer model (default: claude-sonnet-5)
# ANSWER_MODEL=claude-sonnet-5
