# Copy to  backend/.env  and fill in real values.  .env is gitignored.
#
# ============================================================================
#  PRODUCTION  — the only three vars the deployed backend needs.
#  On Render these are set in the dashboard (Environment tab), not from a file.
# ============================================================================

# Supabase read-only role (app_readonly): SELECT only, no DDL, no writes.
# This is the ONLY database credential the deployed API should ever see.
SUPABASE_READONLY_URL=postgresql://app_readonly:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres?sslmode=require

# Anthropic API key for answer generation (same key as Projects 1 & 2).
ANTHROPIC_API_KEY=sk-ant-...

# CORS allow-list. Unset = wide open (fine for a public read-only demo).
# Once the Vercel URL exists, set it here and restart to lock CORS down.
# Comma-separated for more than one origin. No trailing slash.
# ALLOWED_ORIGIN=https://clinical-protocol-qa.vercel.app

# Optional: override the answer model (default: claude-sonnet-5).
# ANSWER_MODEL=claude-sonnet-5


# ============================================================================
#  LOCAL PIPELINE ONLY  — never set this in a deployed environment.
#  Used by setup_supabase.py and load_embeddings.py to create the table and
#  load embeddings from your machine. The deployed API never needs write access.
# ============================================================================

# SUPABASE_OWNER_URL=postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres?sslmode=require

# Free-tier connection note: Supabase's direct host (port 5432) is IPv6-only.
# If your network is IPv4, use the Session-mode pooler host
# (...pooler.supabase.com:5432) instead. Keep sslmode=require either way.
